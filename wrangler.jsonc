// Cloudflare Worker with static assets. You normally do not edit this file.
// - "Deploy to Cloudflare" button: Cloudflare reads this file, creates the D1 database below by itself (that is why there
//   is no database_id), asks for the secrets listed in .dev.vars.example and runs `npm run deploy` (= `wrangler deploy`) on every push.
//   There is no migrations step: the Worker creates its tables itself on the first request (src/migrate.js).
// - Setup script / agent path (see AGENTS.md): `node scripts/setup.mjs` creates the database in the EU jurisdiction and
//   writes its database_id here. database_id is not a secret: it is fine to commit it.
// Settings that the participant does not see (password, mail relay) are SECRETS, never written here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker name; the site lives at https://<name>.<your-account-subdomain>.workers.dev
  "name": "approdo",
  // src/index.js exports default { fetch }: it answers every request (headers, routing, pages, admin).
  "main": "src/index.js",
  "compatibility_date": "2025-07-01",
  // Lets the Worker reach another Worker over the public Internet. Without it Cloudflare answers error 1042 to the anonymous
  // usage report (src/usage.js), which goes to a Worker of the author of Approdo. It changes nothing else: the mail relay and
  // Turnstile are not Workers.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    // The Worker sees every request first, so the security headers and the routing are the same for every file;
    // static files are served through env.ASSETS.fetch inside src/index.js.
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "approdo"
    }
  ],
  "observability": { "enabled": false }
}
